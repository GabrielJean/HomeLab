{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "timezone": "America/Toronto",
  "ignorePaths": [
    "**/Archives/**",
    "Docker/homeassistant/**",
    "Docker/traefik/**"
  ],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "labels": [
    "dependencies"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)K8s/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)K8s/.+\\.ya?ml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/(^|/)K8s/.+kustomization\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Talos Linux versions in Omni manifests",
      "managerFilePatterns": [
        "/(^|/)K8s/Omni/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "talos:\\s+version:\\s+[\"']?v(?<currentValue>[0-9.]+)[\"']?",
        "talos[vV]ersion:\\s+[\"']?(?<currentValue>[0-9.]+)[\"']?"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update Kubernetes versions in Omni manifests",
      "managerFilePatterns": [
        "/(^|/)K8s/Omni/clusters/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "kubernetes:\\s+version:\\s+[\"']?(?<currentValue>v[0-9.]+)[\"']?"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Disable Kubernetes API version deprecation checks across YAML manifests",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "description": "Disable updates for local custom builds and private registry images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "azure-dns-updater",
        "homelab/*",
        "gitea.docker-1.gwebs.ca/**"
      ],
      "enabled": false
    },
    {
      "description": "Disable updates for phased-out Docker services",
      "matchFileNames": [
        "Docker/homeassistant/**",
        "Docker/traefik/**"
      ],
      "enabled": false
    },
    {
      "description": "Label Docker updates",
      "matchFileNames": [
        "Docker/**"
      ],
      "labels": [
        "dependencies",
        "docker"
      ]
    },
    {
      "description": "Label Kubernetes manifest and container updates",
      "matchFileNames": [
        "K8s/**"
      ],
      "labels": [
        "dependencies",
        "kubernetes"
      ]
    },
    {
      "description": "Label Flux and Helm chart updates",
      "matchManagers": [
        "flux"
      ],
      "labels": [
        "dependencies",
        "kubernetes",
        "helm"
      ]
    },
    {
      "description": "Group AdGuard Home non-major updates on Saturdays",
      "matchFileNames": [
        "Docker/adguardhome/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "AdGuard Home",
      "groupSlug": "adguard-home-non-major",
      "automerge": true,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Hold back AdGuard Home major updates for manual PR review on Saturdays",
      "matchFileNames": [
        "Docker/adguardhome/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "AdGuard Home (major)",
      "groupSlug": "adguard-home-major",
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Group Docker game server updates and hold for manual review",
      "matchFileNames": [
        "Docker/satisfactory/**",
        "Docker/zomboid/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "Game servers (Docker)",
      "groupSlug": "docker-game-servers",
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Group and auto-merge non-major Kubernetes app container updates on Saturdays",
      "matchFileNames": [
        "K8s/apps/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "all non-major k8s app images",
      "groupSlug": "k8s-apps-non-major",
      "automerge": true,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Group major Kubernetes app container updates for manual review on Saturdays",
      "matchFileNames": [
        "K8s/apps/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "all major k8s app images",
      "groupSlug": "k8s-apps-major",
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Never auto-merge Kubernetes platform infrastructure and controllers",
      "matchFileNames": [
        "K8s/infrastructure/**",
        "K8s/clusters/**"
      ],
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Group Flux CD controller updates together and hold for manual review",
      "matchPackageNames": [
        "ghcr.io/fluxcd/*"
      ],
      "groupName": "Flux CD controllers",
      "groupSlug": "flux-controllers",
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Group non-major Helm chart updates on Saturdays",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major helm charts",
      "groupSlug": "helm-non-major",
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Hold back major Helm chart updates for manual PR review on Saturdays",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "all major helm charts",
      "groupSlug": "helm-major",
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    },
    {
      "description": "Hold Talos Linux and Kubernetes version bumps for manual review",
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "groupName": "Talos & Kubernetes versions",
      "groupSlug": "talos-k8s",
      "automerge": false,
      "schedule": [
        "before 6am on saturday"
      ]
    }
  ]
}
