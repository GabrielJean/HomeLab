{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "ignorePaths": [
    "**/Archives/**"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "linuxserver/jackett"
      ],
      "automerge": true,
      "schedule": [
        "before 3am on the first day of the month"
      ]
    }
  ]
}
